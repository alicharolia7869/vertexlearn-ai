# ==============================================================================
# VERTEXLEARN AI — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
#
# Note: VertexLearn AI runs fully functional out-of-the-box in client-side &
# verified curriculum knowledge base mode with zero external API keys required.
#
# To optionally enable live LLM generative synthesis for the AI Tutor:
# Set these variables in: Vercel Dashboard > Settings > Environment Variables
#
# 1. Google Gemini API Key (Recommended):
# Obtain free from: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. OpenAI API Key (Alternative):
# Obtain from: https://platform.openai.com/
OPENAI_API_KEY=

# 3. Model Identifier (Defaults to gemini-1.5-flash or gpt-4o-mini):
AI_MODEL=gemini-1.5-flash
